services:
  app:
    image: docker.io/xiexiao064/infinitum-app:latest
    container_name: infinitum
    restart: unless-stopped
    environment:
      NODE_ENV: production
      PORT: 3000
      HOSTNAME: 0.0.0.0
      # 首页页签标题后缀，默认“资讯聚合平台”；如需自定义，在 .env 或 shell 中设置 SITE_HOME_TITLE
      SITE_HOME_TITLE: "${SITE_HOME_TITLE:-资讯聚合平台}"
      DATABASE_URL: file:/app/data/dev.db
      # Canonical public origin for RSS links, e.g. https://your-domain.example
      # SITE_URL: ""
      ADMIN_PASSWORD: change-me
      ADMIN_SESSION_SECRET: replace-with-a-long-random-secret
      ADMIN_SESSION_COOKIE_SECURE: "true"
    ports:
      - "3001:3000"
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - 'fetch("http://127.0.0.1:3000/api/health").then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1));'
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 40s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"
    volumes:
      - infinitum-data:/app/data
  worker:
    image: docker.io/xiexiao064/infinitum-worker:latest
    restart: unless-stopped
    cpus: "${WORKER_CPUS:-0.50}"
    environment:
      NODE_ENV: production
      DATABASE_URL: file:/app/data/dev.db
    volumes:
      - infinitum-data:/app/data

volumes:
  infinitum-data:
